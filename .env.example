# ===================================================================
# WhiteFox B2B Application - Production Environment Configuration
# Copy this file to .env on your production server:
# cp .env.example .env
# ===================================================================

# Database Credentials
POSTGRES_DB=whitefox_prod
POSTGRES_USER=whitefox_admin
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_SECURE_RANDOM_PASSWORD_123!

# JWT Secret (Must be a 256-bit strong base64 key in production)
# Generate with: openssl rand -base64 32
JWT_SECRET=d2hpdGVmb3gtcHJvZC1zZWN1cmUtc2VjcmV0LWtleS1taW4tMjU2LWJpdHMtZGF0YQ==
JWT_EXPIRATION=86400000

# NextAuth Authentication Secret
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=LzMliik+cWnXYHBf8cYjfcNzO5m73WDeWIYr+hFzsSE=
NEXTAUTH_URL=https://yourdomain.com

# Public API & WebSocket Endpoints (Use your domain name)
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api
NEXT_PUBLIC_WS_URL=wss://api.yourdomain.com/ws
